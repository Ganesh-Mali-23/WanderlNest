<% layout("/layouts/boilerplate") %>
<body>
    <div class="row">
          <div class="card col-6 offset-3">
                <h5 class="card-title offset-4"><%= listing.title %></h5>
                <img src="<%= listing.image %>" class="card-img-top" alt="Listing Image" style="height: 30rem ;">
                <div class="card-img-overlay"></div>
                <div class="card-body">
                <p class="card-text">
                    <ul>
                        <li><%= listing.description %></li>
                        <li>&#8377; <%= listing.price.toLocaleString("en-IN") %></li>
                        <li><%= listing.location %></li>
                        <li><%= listing.country %> </li>
                    </ul>
                </p>
                </div>
            </div>
    </div>
    
    <div class="btns offset-3">
        <form method="get" action="/listings/<%= listing.id %>/edit" class="col-1" >
            <button class="add-btn">Edit</button>
        </form>
        <form method="post" action="/listings/<%= listing.id %>?_method=DELETE">
            <button class="add-btn">Delete</button>
        </form>

    </div>
    <br><br>

</body>
