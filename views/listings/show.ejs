<% layout("/layouts/boilerplate") %>
<body>
    <div class="row">
          <div class="card col-6 offset-3 listing-card">
                <h5 class="card-title offset-4"><%= listing.title %></h5>
                <img src="<%= listing.image.url %>" class="card-img-top" alt="Listing Image" style="height: 30rem ;">
                <div class="card-img-overlay"></div>
                <div class="card-body">
                <p class="card-text">
                    <ul>
                        <li><%= listing.description %></li>
                        <li>&#8377; <%= listing.price.toLocaleString("en-IN") %></li>
                        <li><%= listing.location %></li>
                        <li><%= listing.country %> </li>
                    </ul>
                    <p>created by : <%= listing.owner.username %></p>
                </p>
                </div>
            </div>
    </div>
    <% if(currUser && listing.owner._id.equals(currUser._id)) { %>
        <div class="btns offset-3">
        <form method="get" action="/listings/<%= listing.id %>/edit" class="col-1" >
            <button class="add-btn">Edit</button>
        </form>
        <form method="post" action="/listings/<%= listing.id %>?_method=DELETE">
            <button class="add-btn">Delete</button>
        </form>
    <% } %>
    </div>
    <hr>
    <br>

    <div class="col-6 offset-3" >
        <h5>Reviews</h5>
        <div class="row">
            <% for(review of listing.reviews) { %>
            <div class="card col-6 ms-3 mb-3" >  
                <div class="card-body">
                    <h6 class="card-title">@<%= review.author.username %></h6>
                    <p class="card-text"><%= review.comment %></p>
                    <p class="card-text"><%= review.rating %> stars</p>
                </div>
                <form method="post" action="/listings/<%= listing.id %>/reviews/<%= review.id %>?_method=DELETE">
                    
                    <button class="">Delete</button>
                </form>
            </div>
            <% }  %>
        </div>
        <br>
        
        <% if(currUser)  { %>
            <h4>Leave your review</h4>
            <form method="post" action="/listings/<%= listing.id %>/reviews" novalidate class="needs-validation">
                <div>
                    <label for="rating" class="form-label">Rating</label>
                    <input type="range" id="rating" min="1" max="5" class="form-range" name="review[rating]">
                </div>
                <div>
                    <label for="comment" class="form-label">Comment</label>
                    <textarea name="review[comment]" id="comment" class="form-control" required></textarea>
                    <div class="invalid-feedback">Please Enter comment for review</div>
                </div>
                <br>
                <button class="btn btn-outline-dark">Submit</button>
            </form>
        <% } %> 
    </div>
    <br>

</body>
