<% layout("/layouts/boilerplate") %>
<body>
    <div class="row">
        <div class="col-8 offset-2">
           <h1>Edit Listing</h1>
           <form method="post" action="/listings/<%= listing.id %>?_method=PUT" novalidate class="needs-validation">
            <div class="mt-3">
                <label for="title" class="form-label" >Title</label>
                <input type="text" value="<%= listing.title %>" name="listing[title]" class="form-control" required>
                <div class="valid-feedback">Good Title</div>
            </div>
            <div class="mt-3">
                <label for="desription" class="form-label">Desription</label>
                <textarea name="description" id="" class="form-control" required></textarea>
                <div class="invalid-feedback">Description should be present</div>
            </div>
            <div class="mt-3">
                <label for="image" class="form-label">Image URL</label>
                <input type="text" value="<%= listing.image.url %>" name="listing[image][url]" class="form-control" required>
            </div>
            <div class="mt-3">
                <label for="price" class="form-label">Price</label>
                <input type="Number" value="<%= listing.price %>" name="listing[price]" class="form-control" required>
            </div>
            <div class="mt-3">
                <label for="location" class="form-label">Location</label>
                 <input type="text" value="<%= listing.location %>" name="listing[location]" class="form-control" required>
                 <div class="invalid-feedback">Location should be present</div>
            </div>
            <div class="mt-3">
                <label for="country" class="form-label">Country</label>
                <input type="text" value="<%= listing.country %>" name="lisating[country]" class="form-control" required>
                <div class="invalid-feedback">Country should be present</div>
            </div>
           <br>
           <button class="add-btn">Edit</button>
           <br><br>
           </form>
        </div>
    </div>
    
</body>
