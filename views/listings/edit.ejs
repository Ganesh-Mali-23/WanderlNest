<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Edit Listing</h1>
    <form method="post" action="/listings/<%= listing.id %>?_method=PUT">
        <input type="text" value="<%= listing.title %>" name="listing[title]"><br><br>
        <textarea name="description" id=""></textarea><br><br>
        <input type="text" value="<%= listing.image.url %>" name="listing[image][url]"><br><br>
        <input type="Number" value="<%= listing.price %>" name="listing[price]"><br><br>
        <input type="text" value="<%= listing.location %>" name="listing[location]"><br><br>
        <input type="text" value="<%= listing.country %>" name="lisating[country]"><br><br>
        <button>Edit</button>
    </form>
</body>
</html>