<% layout("/layouts/boilerplate") %>
<body>
    <div class="row">
        <div class="col-8 offset-2">
        <h1>Create New Listing</h1>
        <form method="post" action="/listings/new" novalidate class="needs-validation">
        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input type="text" placeholder="Enter title" name="listing[title]" class="form-control" required>
            <div class="valid-feedback">Good Title</div>
        </div>
        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea name="description" id="" class="form-control" required></textarea>
            <div class="invalid-feedback">Description should be present</div>
        </div>
        <div class="mb-2">
            <label for="image" class="form-label">Image URL</label>
            <input type="text" placeholder="Enter img url" name="listing[image][url]" class="form-control">
        </div>
        <div class="mb-3">
            <label for="Price" class="form-label">Price</label>
            <input type="" placeholder="Enter price" name="listing[price]" class="form-control" required>
        </div>
        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input type="text" placeholder="Enter location" name="listing[location]" class="form-control" required>
            <div class="invalid-feedback">Location should be present</div>
        </div>
        <div class="mb-3">
            <label for="country" class="form-label">Country</label>
            <input type="text" placeholder="Enter country" name="listing[country]" class="form-control" required>
            <div class="invalid-feedback">Country should be present</div>
        </div>
        <br><br>
        <button class="add-btn">Add</button>
        <br><br>
        </form>

        </div>
    </div>
    
</body>
